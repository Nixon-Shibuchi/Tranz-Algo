# Copy to .env and adjust
#
# SQLite (zero-setup fallback):
# DATABASE_URL=sqlite:///./tranzalgo.db
#
# PostgreSQL via Docker Compose (from repo root: docker compose up -d):
DATABASE_URL=postgresql+psycopg://tranzalgo:tranzalgo@127.0.0.1:5432/tranzalgo
#
# Also accepted: postgresql://… or postgres://… (normalized to +psycopg)

SECRET_KEY=change-me-in-production-use-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FX_API_BASE=https://api.frankfurter.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
